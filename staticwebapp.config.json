{
  "routes": [
    {
      "route": "/privacy",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms.html"
    },
    {
      "route": "/cz/privacy",
      "rewrite": "/cz/privacy.html"
    },
    {
      "route": "/cz/terms",
      "rewrite": "/cz/terms.html"
    },
    {
      "route": "/de/privacy",
      "rewrite": "/de/privacy.html"
    },
    {
      "route": "/de/terms",
      "rewrite": "/de/terms.html"
    },
    {
      "route": "/en/privacy",
      "rewrite": "/en/privacy.html"
    },
    {
      "route": "/en/terms",
      "rewrite": "/en/terms.html"
    },
    {
      "route": "/cz",
      "redirect": "/cz/",
      "statusCode": 301
    },
    {
      "route": "/de",
      "redirect": "/de/",
      "statusCode": 301
    },
    {
      "route": "/en",
      "redirect": "/en/",
      "statusCode": 301
    },
    {
      "route": "/navod-importu",
      "redirect": "/navod-importu/",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/cz/*",
      "/de/*",
      "/en/*",
      "/navod-importu/*",
      "/assets/*",
      "/robots.txt",
      "/sitemap.xml",
      "*.html",
      "*.css",
      "*.js",
      "*.txt",
      "*.xml",
      "*.json",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.svg",
      "*.webp",
      "*.ico",
      "*.woff",
      "*.woff2"
    ]
  }
}
