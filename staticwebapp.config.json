{
  "routes": [
    {
      "route": "/privacy",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms.html"
    },
    {
      "route": "/cz",
      "redirect": "/cz/",
      "statusCode": 301
    },
    {
      "route": "/de",
      "redirect": "/de/",
      "statusCode": 301
    },
    {
      "route": "/en",
      "redirect": "/en/",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/cz/*",
      "/de/*",
      "/en/*",
      "*.html",
      "*.css",
      "*.js",
      "*.png",
      "*.jpg",
      "*.svg",
      "*.webp"
    ]
  }
}
